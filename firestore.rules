rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function admin() {
      return signedIn() && request.auth.token.email in [
        'matheus.nogueira4@portalsesisp.org.br',
        'matheus.nogueira7734@gmail.com'
      ];
    }
    function member() {
      return signedIn() && (
        admin()
        || request.auth.token.email.matches('.*@portalsesisp[.]org[.]br')
        || exists(/databases/$(db)/documents/allow/$(request.auth.token.email))
      );
    }
    function roomMember(roomId) {
      return member()
        && exists(/databases/$(db)/documents/rooms/$(roomId)/members/$(request.auth.uid))
        && get(/databases/$(db)/documents/rooms/$(roomId)/members/$(request.auth.uid)).data.status == 'active';
    }

    match /allow/{e} { allow read, write: if false; }

    // Diretório legado ainda usado pelo painel; a próxima etapa deve limitar por sala.
    match /users/{u} {
      allow read: if member();
      allow create, update: if member() && request.auth.uid == u;
      allow delete: if admin() || request.auth.uid == u;
    }
    match /reports/{u} {
      allow read: if admin() || (member() && request.auth.uid == u);
      allow create, update: if member() && request.auth.uid == u;
      allow delete: if admin();
    }

    // Descoberta de salas é exclusiva dos guias; aluno só acessa sala após matrícula.
    match /rooms/{roomId} {
      allow get: if admin() || roomMember(roomId);
      allow list: if admin();
      allow create, update, delete: if admin();
      match /members/{uid} {
        allow get: if admin() || (roomMember(roomId) && request.auth.uid == uid);
        allow list: if admin() || roomMember(roomId);
        allow create, update, delete: if false;
      }
      match /bank/{bankId} {
        allow read: if admin() || roomMember(roomId);
        allow write: if false;
      }
    }

    // Banco-fonte privado do guia; alunos leem somente o banco da própria sala.
    match /bank/{d} { allow read, write: if admin(); }

    // Coleções globais legadas serão migradas em uma próxima etapa.
    match /challenges/{d} { allow read: if member(); allow write: if admin(); }
    match /msgs/{u} {
      allow read: if member();
      allow create, update: if member() && request.auth.uid == u;
      allow delete: if admin() || request.auth.uid == u;
    }
    match /data/users/{u}/{rest=**} {
      allow read, write: if member() && request.auth.uid == u;
    }
    match /iaUse/{d} { allow read, write: if false; }
  }
}